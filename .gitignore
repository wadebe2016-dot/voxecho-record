# dépendances
node_modules/
.pnpm-store/

# build
dist/
build/
*.tsbuildinfo

# tests / couverture
coverage/
.vitest/

# environnement — jamais de secret dans le dépôt
.env
.env.*
!.env.example
# Les modèles d'environnement de déploiement, eux, doivent être versionnés :
# ils ne portent que des noms de variables et des valeurs vides. `.env.*` les
# attrapait, et `git add -A` les ignorait sans rien dire — le runbook renvoyait
# alors vers un fichier absent de l'instance.
!*.env.prod.example
!deploy/.env.prod.example

# données locales (audio ingéré, quarantaine)
/data/
var/

# éditeurs / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
