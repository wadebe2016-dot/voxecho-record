// Modèle de données VoxEcho Record — CLAUDE.md §5.
// Règle transverse : `tenant_id` sur toutes les tables métier, cloisonnement
// vérifié par middleware et par tests.

generator client {
  provider      = "prisma-client-js"
  // Cible explicite : dans une image slim, Prisma détecte mal la version
  // d'OpenSSL et génère un client dont le moteur ne se charge pas.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  AUDITOR
}

/// Direction de l'appel, telle que déposée par la capture (contrat §3).
enum Direction {
  outbound
  inbound
  internal
}

/// Origine de la capture (contrat §3).
enum Source {
  cucm_bib  @map("cucm-bib")
  siprec
  simulator
}

/// Cycle de vie d'un enregistrement.
enum RecordingStatus {
  stored
  archived
  purged
  hold
}

/// Actions tracées. Le journal est append-only.
enum AuditAction {
  LOGIN
  SEARCH
  LISTEN
  EXPORT
  INGEST
  QUARANTINE
  PURGE
  HOLD_SET
  HOLD_RELEASE
  /// Changement de la durée de conservation d'un locataire (CLAUDE.md §9.6).
  /// Raccourcir une rétention détruit des preuves à terme : l'acte doit se
  /// lire au journal comme n'importe quelle autre destruction.
  RETENTION_SET

  /// Publication d'une politique d'enregistrement (CLAUDE.md §9.23). Décider
  /// de ne pas enregistrer certains appels est au moins aussi lourd que
  /// raccourcir une conservation : c'est renoncer d'avance à une preuve.
  POLICY_SET

  /// Création, changement de rôle, activation ou réinitialisation d'un compte
  /// (CLAUDE.md §9.26). Donner à quelqu'un le droit d'entendre des
  /// conversations de clients doit se lire au journal.
  USER_SET
}

/// Cycle de vie d'une version de politique d'enregistrement.
enum PolicyStatus {
  /// En cours d'écriture. Modifiable, abandonnable, sans effet sur la capture.
  draft
  /// Publiée : immuable, et opposable. Un déclencheur en base l'y contraint.
  published
}

model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  /// Identifiant stable et sûr en chemin : c'est le nom du sous-répertoire
  /// que surveille l'ingestion, `INGEST_DIR/<slug>/` (contrat §3). Le nom
  /// commercial peut changer, le slug non — il est écrit dans l'arborescence
  /// que la capture alimente.
  slug String @unique

  /// Un locataire désactivé n'ingère plus : les dépôts trouvés dans son
  /// sous-répertoire partent en quarantaine (contrat §3). On ne supprime pas
  /// un locataire dont le journal n'est pas vide, on le désactive.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  users             User[]
  recordings        Recording[]
  auditEvents       AuditEvent[]
  retentionPolicies RetentionPolicy[]
  purgeRuns         PurgeRun[]
  recordingPolicies RecordingPolicyVersion[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)

  /// Administrateur de l'instance, et non d'un locataire — CLAUDE.md §9.22.
  /// Le §9.9 avait laissé la réserve : les trois rôles confondent
  /// l'administration de l'instance et l'habilitation métier. Le privilège est
  /// porté à part plutôt que par un quatrième rôle qui recouperait mal les
  /// autres : un ADMIN reste l'administrateur de son locataire, certains sont
  /// en plus administrateurs de l'instance.
  ///
  /// Il ne se donne pas depuis le portail : c'est une commande d'exploitation
  /// (`admin:instance`), pour qu'un compte ADMIN compromis ne puisse pas
  /// s'attribuer les pleins pouvoirs.
  instanceAdmin Boolean @default(false) @map("instance_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  /// Mot de passe provisoire à renouveler — CLAUDE.md §9.26. Tant qu'il est
  /// vrai, l'api ne laisse passer que le profil, le changement de mot de passe
  /// et la déconnexion : un compte créé par un administrateur ne doit pas
  /// s'utiliser avec le mot de passe que cet administrateur a lu.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  // Verrouillage après échecs de connexion (§5).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditEvents        AuditEvent[]
  refreshTokens      RefreshToken[]
  legalHoldsSet      LegalHold[]    @relation("LegalHoldSetBy")
  legalHoldsReleased LegalHold[]    @relation("LegalHoldReleasedBy")
  purgeRunsCreated   PurgeRun[]     @relation("PurgeRunCreatedBy")
  purgeRunsExecuted  PurgeRun[]     @relation("PurgeRunExecutedBy")
  purgeRunsCancelled PurgeRun[]     @relation("PurgeRunCancelledBy")
  policiesCreated    RecordingPolicyVersion[] @relation("PolicyCreatedBy")
  policiesPublished  RecordingPolicyVersion[] @relation("PolicyPublishedBy")

  @@index([tenantId])
  @@map("users")
}

/// Jetons de rafraîchissement, stockés hachés pour permettre la révocation.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("refresh_tokens")
}

model Recording {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  refci       String
  near        String
  far         String
  direction   Direction
  startedAt   DateTime        @map("started_at")
  durationSec Int             @map("duration_sec")
  filePath    String          @map("file_path")
  sha256      String
  sizeBytes   BigInt          @map("size_bytes")
  source      Source
  status      RecordingStatus @default(stored)
  createdAt   DateTime        @default(now()) @map("created_at")

  /// Catégorie d'opération bancaire (contrat §3, CLAUDE.md §9.10). Décrit ce
  /// qui se joue dans l'appel, non ce qu'il est. Volontairement une chaîne et
  /// non une énumération : le catalogue doit pouvoir s'étendre par locataire
  /// sans migration. `autre` quand le producteur n'en déclare aucune.
  operationCategory String @default("autre") @map("operation_category")

  // Chiffrement au repos prévu en S4 : les colonnes existent déjà pour que
  // l'activation n'impose pas de migration lourde (CLAUDE.md §8).
  encrypted Boolean @default(false)
  keyRef    String? @map("key_ref")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditEvents   AuditEvent[]
  legalHolds    LegalHold[]
  purgeRunItems PurgeRunItem[]

  // Idempotence de l'ingestion : le nom du fichier est conservé, un
  // re-dépôt retombe donc sur le même chemin de destination (contrat §3).
  @@unique([tenantId, filePath])
  @@index([tenantId, startedAt])
  @@index([tenantId, near])
  @@index([tenantId, far])
  @@index([tenantId, status])
  @@index([tenantId, sha256])
  /// Recherche par catégorie, et futures politiques de rétention par
  /// catégorie (`RetentionPolicy.appliesTo`).
  @@index([tenantId, operationCategory])
  @@map("recordings")
}

/// Journal d'audit — append-only. Aucune route d'update ni de delete, et un
/// garde-fou en base (déclencheur SQL) refuse toute modification.
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  /// Nul pour les seuls événements que l'instance ne peut rattacher à
  /// personne : un dépôt trouvé dans un sous-répertoire d'ingestion qui ne
  /// correspond à aucun locataire actif (contrat §3). Le journal reste
  /// cloisonné — une requête d'un locataire ne voit que ses propres
  /// événements — et ces événements système ne sont lisibles que par un
  /// ADMIN de l'instance.
  tenantId String? @map("tenant_id") @db.Uuid

  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  recordingId String?     @map("recording_id") @db.Uuid
  detail      Json?       @db.JsonB
  ip          String?
  at          DateTime    @default(now())

  // Le journal étant append-only, aucune suppression en cascade ne peut le
  // toucher : effacer un locataire, un compte ou un enregistrement qui a
  // laissé une trace est refusé. Un compte se désactive (`User.active`), un
  // enregistrement se purge (`RecordingStatus.purged`) — ni l'un ni l'autre
  // ne s'efface.
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: Restrict)

  @@index([tenantId, at])
  @@index([tenantId, action])
  @@index([tenantId, userId])
  @@index([recordingId])
  @@map("audit_events")
}

/// Durée de conservation d'un locataire. Le défaut d'un nouveau locataire est
/// de 730 jours ; l'api refuse de descendre sous le plancher `RETENTION_MIN_DAYS`
/// sans dérogation motivée (CLAUDE.md §9.6).
/// Cycle de vie d'un rapport de purge. Un rapport naît simulé : c'est une
/// autorisation à demander, pas une destruction en cours.
enum PurgeRunStatus {
  simulated
  executed
  cancelled
}

/// Sort d'un enregistrement dans un rapport de purge.
enum PurgeItemOutcome {
  /// Candidat retenu par le rapport, pas encore détruit.
  candidate
  /// Détruit à l'exécution.
  purged
  /// Épargné : une conservation forcée était active.
  blocked
  /// Détruit en base, mais le fichier manquait déjà au stockage.
  missing
}

/// Rapport de purge — CLAUDE.md §9.7.
///
/// Le rapport **est** l'autorisation : un responsable conformité le lit, puis
/// l'exécution le désigne par son identifiant. Rien ne se détruit qui n'ait
/// été énuméré, chiffré et daté d'abord.
model PurgeRun {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  status   PurgeRunStatus @default(simulated)

  /// Politique en vigueur au moment du rapport, et date d'échéance qui en
  /// découle. Toutes deux figées : l'exécution rejoue le rapport, elle ne le
  /// recalcule pas à la date du jour.
  policyDays Int      @map("policy_days")
  cutoff     DateTime

  /// Durées appliquées à chaque périmètre, figées — CLAUDE.md §9.28. Une
  /// seule durée ne suffit plus dès qu'une catégorie d'opération a la sienne,
  /// et l'exécution doit rejouer exactement ce qui a été autorisé.
  policyDocument Json? @map("policy_document") @db.JsonB

  candidateCount Int    @map("candidate_count")
  candidateBytes BigInt @map("candidate_bytes")
  blockedCount   Int    @map("blocked_count")
  blockedBytes   BigInt @map("blocked_bytes")

  /// Empreinte du certificat de destruction, calculée à l'exécution —
  /// CLAUDE.md §9.31. Elle porte sur le contenu, non sur le fichier : le PDF
  /// et le CSV du même rapport rendent la même valeur, et un contrôleur peut
  /// vérifier des mois plus tard que le certificat qu'on lui présente est
  /// bien celui qui a été délivré.
  certificateSha256 String? @map("certificate_sha256")

  /// Motif de la destruction, tel qu'il a été saisi à l'exécution. Il était
  /// jusqu'ici relu depuis le premier `PURGE` du journal — ce qui ne rendait
  /// rien quand la purge n'avait détruit aucune pièce, et faisait dire au
  /// certificat « motif non consigné » alors qu'un motif avait été donné.
  /// Nul sur les rapports exécutés avant cette colonne : le motif se relit
  /// alors au journal, comme auparavant.
  executionReason String? @map("execution_reason")

  /// Empreinte de l'ensemble énuméré (identifiants triés, état de hold
  /// compris). Si le monde a changé entre la lecture et l'exécution, elle ne
  /// concorde plus et l'exécution est refusée : ce qui a été autorisé n'est
  /// plus ce qui serait détruit.
  fingerprint String

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  executedBy  String?   @map("executed_by") @db.Uuid
  executedAt  DateTime? @map("executed_at")
  purgedCount Int?      @map("purged_count")
  purgedBytes BigInt?   @map("purged_bytes")

  cancelledBy String?   @map("cancelled_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser   User           @relation("PurgeRunCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  executedByUser  User?          @relation("PurgeRunExecutedBy", fields: [executedBy], references: [id], onDelete: Restrict)
  cancelledByUser User?          @relation("PurgeRunCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  items           PurgeRunItem[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("purge_runs")
}

/// Une ligne du rapport. Les appels épargnés par une conservation forcée y
/// figurent au même titre que les candidats : un rapport qui ne montrerait
/// que ce qu'on détruit laisserait croire qu'il n'y avait rien à épargner.
/// Une ligne d'un rapport de purge. Elle porte ce qu'il faut pour écrire le
/// certificat de destruction sans relire l'enregistrement — qui, lui, n'aura
/// peut-être plus de fichier (CLAUDE.md §9.31).
model PurgeRunItem {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  purgeRunId  String           @map("purge_run_id") @db.Uuid
  recordingId String           @map("recording_id") @db.Uuid
  outcome     PurgeItemOutcome @default(candidate)

  /// Copiés au moment du rapport : ils doivent rester lisibles tels qu'ils
  /// étaient quand la décision a été prise.
  sizeBytes BigInt   @map("size_bytes")
  startedAt DateTime @map("started_at")

  /// Catégorie d'opération et durée qui lui a été appliquée — CLAUDE.md §9.31.
  /// Le certificat de destruction doit dire au nom de quelle durée chaque
  /// pièce a été détruite, et l'enregistrement n'a plus de fichier pour en
  /// témoigner. Nuls pour les rapports antérieurs à cette exigence.
  operationCategory String? @map("operation_category")
  policyDays        Int?    @map("policy_days")

  blocked        Boolean
  blockingReason String? @map("blocking_reason")

  purgeRun  PurgeRun  @relation(fields: [purgeRunId], references: [id], onDelete: Cascade)
  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Restrict)

  @@unique([purgeRunId, recordingId])
  @@index([tenantId])
  @@index([purgeRunId, blocked])
  @@map("purge_run_items")
}

model RetentionPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  days      Int
  appliesTo String   @map("applies_to")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// Motif écrit d'une rétention inférieure au plancher réglementaire. Nul
  /// tant que la durée reste au-dessus. Ce n'est pas un doublon du journal :
  /// le journal dit qui a dérogé et quand, cette colonne dit que la politique
  /// **en vigueur** est une dérogation — ce qu'un contrôleur lit d'abord.
  belowFloorReason String? @map("below_floor_reason")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appliesTo])
  @@map("retention_policies")
}

/// Conservation forcée : la purge respecte les holds (§5).
/// Conservation forcée : la purge respecte les holds (§5). Un hold actif est
/// une ligne dont `releasedAt` est nul — c'est la seule source de vérité, le
/// statut de l'enregistrement n'en porte pas de copie (CLAUDE.md §9.6).
model LegalHold {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  recordingId String    @map("recording_id") @db.Uuid
  setBy       String    @map("set_by") @db.Uuid
  reason      String

  /// Référence du dossier qui justifie la conservation — réquisition,
  /// contentieux, enquête interne (CLAUDE.md §9.29). Libre, parce que chaque
  /// banque numérote ses dossiers à sa façon ; exigée, parce qu'un motif sans
  /// référence oblige à retrouver qui l'a posé pour savoir de quoi il parle.
  caseReference String @map("case_reference")

  at          DateTime  @default(now())
  releasedAt  DateTime? @map("released_at")

  /// Lever un hold rend l'appel purgeable : l'acte est aussi lourd que la
  /// pose, et se trace comme elle.
  releasedBy    String? @map("released_by") @db.Uuid
  releaseReason String? @map("release_reason")

  /// Vrai quand la levée n'a pas pu être contre-validée faute d'un second
  /// administrateur actif (§9.29). Le fait est consigné plutôt qu'empêché :
  /// une instance à un seul administrateur ne doit pas se retrouver dans
  /// l'impossibilité de lever une conservation devenue sans objet.
  releasedWithoutSecondApproval Boolean @default(false) @map("released_without_second_approval")

  recording      Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  setByUser      User      @relation("LegalHoldSetBy", fields: [setBy], references: [id])
  releasedByUser User?     @relation("LegalHoldReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([recordingId])
  /// Recherche du hold actif d'un enregistrement, et de tous les holds actifs
  /// d'un locataire au moment de la purge.
  @@index([tenantId, releasedAt])
  @@map("legal_holds")
}

/// Politique d'enregistrement sélectif — CLAUDE.md §9.23.
///
/// Une version publiée ne se modifie jamais : on en publie une nouvelle. C'est
/// la seule façon de répondre à « quelle politique s'appliquait le 12 mars ? »,
/// et cette question sera posée, précisément parce que le produit renonce à
/// enregistrer certains appels. Un déclencheur en base l'impose, comme pour le
/// journal d'audit (§5) : l'absence de route d'écriture ne suffit pas quand la
/// valeur probante en dépend.
model RecordingPolicyVersion {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  /// Numéro croissant par locataire. C'est lui qui voyage avec chaque décision
  /// d'enregistrement, et qu'un contrôleur citera.
  version  Int
  status   PolicyStatus @default(draft)

  /// La politique elle-même, telle que validée par le contrat partagé.
  document Json @db.JsonB

  /// Ce que cette version change, écrit par qui la publie. Exigé à la
  /// publication : une politique qui renonce à des preuves ne se pousse pas
  /// sans un mot d'explication.
  note String?

  /// Empreinte du document publié, pour que le connecteur puisse vérifier
  /// qu'il applique bien ce qui a été décidé.
  sha256 String?

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedBy String?   @map("published_by") @db.Uuid
  publishedAt DateTime? @map("published_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auteur  User   @relation("PolicyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  editeur User?  @relation("PolicyPublishedBy", fields: [publishedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("recording_policy_versions")
}
