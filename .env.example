# ─── VoxEcho Record — variables d'environnement ────────────────────────────
# Copier en `.env` et renseigner. Aucun secret réel ne doit être commité.

# Environnement d'exécution : development | test | production
NODE_ENV=development
TZ=Africa/Douala

# ─── Base de données ───────────────────────────────────────────────────────
POSTGRES_USER=voxecho
POSTGRES_PASSWORD=changeme
POSTGRES_DB=voxecho
POSTGRES_PORT=5432
DATABASE_URL=postgresql://voxecho:changeme@localhost:5432/voxecho?schema=public

# ─── API ───────────────────────────────────────────────────────────────────
API_PORT=3000
# Origines autorisées pour le portail (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# ─── Authentification ──────────────────────────────────────────────────────
# Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Verrouillage de compte après échecs de connexion
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MIN=15
# Billet d'écoute : le lecteur audio ne peut pas porter d'en-tête
# Authorization, il présente ce billet court, lié à un seul enregistrement.
# Sa durée borne aussi ce que dure « une écoute » au journal (CLAUDE.md §6).
LISTEN_TICKET_TTL=30m

# ─── Conservation ──────────────────────────────────────────────────────────
# Plancher de l'instance, en jours. Une politique de locataire plus courte est
# refusée sans motif écrit, lequel est consigné au journal d'audit.
RETENTION_MIN_DAYS=730

# ─── Stockage des enregistrements ──────────────────────────────────────────
# Un chemin relatif est ancré à la racine du dépôt, jamais au répertoire
# courant : l'api trouve les mêmes fichiers qu'on la lance depuis la racine ou
# depuis apps/api. En livraison, ces trois chemins sont absolus.
# Répertoire surveillé où la capture dépose wav + json (contrat §3).
# La capture dépose dans le sous-répertoire du locataire : INGEST_DIR/<slug>/
INGEST_DIR=./data/ingest
# Destination probante : STORAGE_DIR/<tenantId>/<yyyy>/<mm>/ (CLAUDE.md §9.3)
STORAGE_DIR=./data/storage
# Chiffrement au repos des pièces audio (AES-256-GCM par trames, §9.13).
# La clé maître ne doit jamais être commitée : la générer par
# `openssl rand -base64 32` et la fournir en secret d'exécution.
STORAGE_ENCRYPTION_ENABLED=false
STORAGE_MASTER_KEY=
# Référence de la clé en service, inscrite sur chaque pièce scellée. La
# changer en même temps que la clé permet aux deux générations de coexister.
STORAGE_KEY_REF=k1

# Sauvegardes : une prise par sous-répertoire daté (dump de la base,
# inventaire du stockage, manifeste). Les fichiers audio n'y sont pas
# recopiés — ils se sauvegardent par les moyens de l'exploitant, et
# `sauvegarde:verifier --stockage` prouve que la copie est complète.
# La clé maître n'y est jamais écrite : seule son empreinte l'est.
BACKUP_DIR=./data/backups

# Fichiers non conformes (jamais de suppression silencieuse)
QUARANTINE_DIR=./data/quarantine
# Balayage périodique d'INGEST_DIR (plutôt qu'inotify : volumes montés)
INGEST_POLL_ENABLED=true
INGEST_POLL_MS=5000
# Délai après lequel un wav resté sans json part en quarantaine (minutes)
INGEST_ORPHAN_MIN=10

# ─── Portail (apps/web, build Vite) ────────────────────────────────────────
VITE_API_URL=http://localhost:3000
