# ─── VoxEcho Record — variables d'environnement ────────────────────────────
# Copier en `.env` et renseigner. Aucun secret réel ne doit être commité.

# Environnement d'exécution : development | test | production
NODE_ENV=development
TZ=Africa/Douala

# ─── Base de données ───────────────────────────────────────────────────────
POSTGRES_USER=voxecho
POSTGRES_PASSWORD=changeme
POSTGRES_DB=voxecho
POSTGRES_PORT=5432
DATABASE_URL=postgresql://voxecho:changeme@localhost:5432/voxecho?schema=public

# ─── API ───────────────────────────────────────────────────────────────────
API_PORT=3000
# Origines autorisées pour le portail (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# ─── Authentification ──────────────────────────────────────────────────────
# Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Verrouillage de compte après échecs de connexion
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MIN=15

# ─── Stockage des enregistrements ──────────────────────────────────────────
# Répertoire surveillé où la capture dépose wav + json (contrat §3).
# La capture dépose dans le sous-répertoire du locataire : INGEST_DIR/<slug>/
INGEST_DIR=./data/ingest
# Destination probante : STORAGE_DIR/<tenant>/<yyyy>/<mm>/
STORAGE_DIR=./data/storage
# Fichiers non conformes (jamais de suppression silencieuse)
QUARANTINE_DIR=./data/quarantine
# Balayage périodique d'INGEST_DIR (plutôt qu'inotify : volumes montés)
INGEST_POLL_ENABLED=true
INGEST_POLL_MS=5000
# Délai après lequel un wav resté sans json part en quarantaine (minutes)
INGEST_ORPHAN_MIN=10

# ─── Portail (apps/web, build Vite) ────────────────────────────────────────
VITE_API_URL=http://localhost:3000
