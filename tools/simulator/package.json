{
  "name": "@voxecho/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulateur de dépôts d'appels — contrat §3 sans téléphonie (CLAUDE.md §4)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "simulate": "dotenv -e ../../.env -- tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@voxecho/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
