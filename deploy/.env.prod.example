# ─── Instance d'évaluation record.voxecho.cm ───────────────────────────────
# Copier en `.env` SUR L'INSTANCE et renseigner. Aucun de ces secrets ne doit
# revenir dans le dépôt.
#
#   JWT_ACCESS_SECRET   : openssl rand -base64 48
#   JWT_REFRESH_SECRET  : openssl rand -base64 48   (différent du précédent)
#   POSTGRES_PASSWORD   : openssl rand -hex 24
#                         (l'URL de connexion est encodée par le produit,
#                          mais ce mot de passe passe aussi par psql et
#                          pg_dump, où un `/` se paie en échappement oublié)
#   STORAGE_MASTER_KEY  : openssl rand -base64 32   (32 octets exactement)
#
# STORAGE_MASTER_KEY commande la lisibilité de toutes les pièces audio. La
# perdre rend le stockage définitivement muet ; la garder uniquement sur cette
# machine revient à ne pas l'avoir sauvegardée (CLAUDE.md §9.13, §9.14).

POSTGRES_USER=voxecho
POSTGRES_PASSWORD=
POSTGRES_DB=voxecho

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

STORAGE_MASTER_KEY=
STORAGE_KEY_REF=k1

# Adresse à laquelle Let's Encrypt écrira avant l'expiration d'un certificat.
ACME_EMAIL=

# Longueur minimale d'un mot de passe des comptes du portail (§9.26).
PASSWORD_MIN_LENGTH=12

# Minimums réglementaires par catégorie (§9.30), « categorie:jours » séparés
# par des virgules. Vide tant qu'aucun texte n'est établi : le produit ne fait
# pas semblant de connaître une durée légale.
RETENTION_REGULATORY_FLOORS=

# Réseau des conteneurs, dont on accepte le X-Forwarded-For (§9.16).
TRUSTED_PROXIES=172.16.0.0/12

# Version des images à exécuter. `latest` suit main ; figer un SHA pour
# revenir en arrière sans reconstruire.
VOXECHO_TAG=latest

# Mention « version d'évaluation » affichée par le portail.
INSTANCE_EVALUATION=true

# ─── Comptes d'évaluation (lus par le seed, une seule fois) ────────────────
# Le seed refuse de créer un compte dont le mot de passe est laissé vide ou
# gardé à sa valeur d'exemple : des identifiants par défaut sur une instance
# publique sont une porte ouverte.
EVAL_ADMIN_EMAIL=admin@banque-meridienne.cm
EVAL_ADMIN_PASSWORD=
EVAL_AUDITOR_EMAIL=auditeur@banque-meridienne.cm
EVAL_AUDITOR_PASSWORD=
EVAL_SUPERVISOR_EMAIL=superviseur@banque-meridienne.cm
EVAL_SUPERVISOR_PASSWORD=

# Mode de déploiement — CLAUDE.md §9.36. `cloud` (défaut) masque les sections
# de réglages qui n'ont de sens que sur un boîtier installé chez le client :
# serveurs de temps, résolveurs. `onprem` les affiche.
VOXECHO_DEPLOY_MODE=cloud
