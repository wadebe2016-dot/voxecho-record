{
  "name": "@voxecho/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types partagés VoxEcho — dont le contrat d'ingestion (CLAUDE.md §3)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
